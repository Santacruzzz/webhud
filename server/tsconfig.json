{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"target": "es5",
		"module": "es2015",
		"resolveJsonModule": true,
		"lib": ["es2017"],
		"types": ["node"],
		"skipLibCheck": true,
		"suppressImplicitAnyIndexErrors": true,
		"noImplicitAny": false
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.json"]
}
